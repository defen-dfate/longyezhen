# 环境变量示例 —— 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# 本地开发时 vite 会自动读取；GitHub Actions 通过仓库 Variables 注入，无需提交密钥

# 部署到 GitHub Pages 时的子路径，形如 /<仓库名>/ ；本地开发保持 /
VITE_PUBLIC_PATH=/

# 认证模式：mock（前端模拟，默认）| api（对接真实后端）
VITE_AUTH_MODE=mock

# 真实后端基地址（仅 VITE_AUTH_MODE=api 时生效）
VITE_API_BASE=

# 天地图 key（可选）。配置后 WebGIS 可使用矢量/影像/地形瓦片底图；
# 未配置时自动回退到自绘经纬网格底图（零 key 即可运行）
VITE_TIANDITU_KEY=
